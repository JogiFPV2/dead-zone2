{
  "name": "@deadzone/map",
  "version": "0.0.0",
  "private": true,
  "description": "Narzędzie deweloperskie: budowanie map w chunkach z blueprintów i walidacja map",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./blueprints/*": "./blueprints/*"
  },
  "files": [
    "dist",
    "blueprints"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "map": "tsx src/cli.ts",
    "osm:convert": "tsx src/osm/cli-convert.ts",
    "osm:scene": "tsx src/osm/cli-scene.ts",
    "osm:plan-png": "tsx src/osm/cli-plan-png.ts"
  },
  "dependencies": {
    "@deadzone/content": "workspace:*",
    "prettier": "^3.9.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "tsx": "^4.23.15"
  }
}
