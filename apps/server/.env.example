# apps/server: copy to .env (never commit it). Values come from the Deadzone Supabase project
# (Project Settings → API). The service role key stays on the server only.
PORT=3001
HOST=0.0.0.0
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Optional, defaults shown:
# SUPABASE_JWT_ISSUER=https://<project-ref>.supabase.co/auth/v1
# SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
# SUPABASE_JWT_AUDIENCE=authenticated
# SAVES_BUCKET=saves
# Proxy hops in front of the server (for the client IP in rate limits), 0 = none:
# TRUST_PROXY_HOPS=0
# SIGNED_URL_TTL_SECONDS=60
# WORLDGEN_VERSION=1
# Newest accepted sim save version (older ones the sim still loads are accepted too):
# SAVE_FORMAT_VERSION=3
# Limits can only be lowered below the product values (docs/backend.md §5.5):
# LIMIT_ALIVE_CHARACTERS=20
# LIMIT_ACCOUNT_SAVE_BYTES=52428800
# LIMIT_NEW_CHARACTERS_PER_DAY=10
# LIMIT_ENVELOPE_BYTES=16777216
# LIMIT_STATE_BYTES=67108864
# LIMIT_SAVES_PER_HOUR=120
# LIMIT_UPLOAD_BYTES_PER_DAY=209715200
# LIMIT_IP_REQUESTS_PER_5_MIN=300
# DZSV validation in worker threads (0 workers = CPU count - 1):
# VALIDATION_WORKERS=0
# VALIDATION_TIMEOUT_MS=5000
# VALIDATION_HEAP_MB=512
