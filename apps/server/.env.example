# apps/server: copy to .env (never commit it). Values come from the Deadzone Supabase project
# (Project Settings → API). The service role key stays on the server only.
PORT=3001
HOST=0.0.0.0
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Optional, defaults shown:
# SUPABASE_JWT_ISSUER=https://<project-ref>.supabase.co/auth/v1
# SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
# SUPABASE_JWT_AUDIENCE=authenticated
# SAVES_BUCKET=saves
# SIGNED_URL_TTL_SECONDS=60
# WORLDGEN_VERSION=1
# SAVE_FORMAT_VERSION=1
# Limits can only be lowered below the product values (docs/backend.md §5.5):
# LIMIT_ALIVE_CHARACTERS=20
# LIMIT_ACCOUNT_SAVE_BYTES=52428800
# LIMIT_NEW_CHARACTERS_PER_DAY=10
# LIMIT_ENVELOPE_BYTES=16777216
# LIMIT_STATE_BYTES=67108864
